<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Obed Guys Corp.</Company>
	<Authors>Floyzi</Authors>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Catapult.Runtime.Protocol</PackageId>
    <Description>Runtime implementation of Fall Guys Catapult protocol</Description>
    <Version>89.0.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<RepositoryUrl>https://github.com/floyzi/Catapult.Runtime.Protocol</RepositoryUrl>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
	  <None Include="../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);CopyReferences
    </TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CopyReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" TargetPath="%(ReferenceCopyLocalPaths.DestinationSubPath)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
	  <ProjectReference Include="..\Catapult.Core\Catapult.Core.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\Catapult.Modules.Items.Protocol\Catapult.Modules.Items.Protocol.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\Catapult.Protocol\Catapult.Protocol.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\Catapult.Services.Gateway.Protocol.Client\Catapult.Services.Gateway.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\Catapult.Services.Login.Protocol.Client\Catapult.Services.Login.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Common.Debug.Protocol.Client\FallGuys.Common.Debug.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Common.Targeting.Protocol.Client\FallGuys.Common.Targeting.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Gateway.Protocol.Client\FallGuys.Gateway.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Level.Protocol.AuthTokens\FallGuys.Level.Protocol.AuthTokens.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Lobby.Protocol.Client\FallGuys.Lobby.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Lobby.Protocol.Common\FallGuys.Lobby.Protocol.Common.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Match.Protocol.Client\FallGuys.Match.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Player.Protocol.Client\FallGuys.Player.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Store.Protocol.Client\FallGuys.Store.Protocol.Client.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	  <ProjectReference Include="..\FallGuys.Client.Protocol\FallGuys.Client.Protocol.csproj">
		  <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
  </ItemGroup>

</Project>